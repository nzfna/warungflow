# apps/api/.env
# Connection string WAJIB yang pooled (-pooler) dari Neon.
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Wajib di production: minimal 32 karakter acak, dan keduanya harus berbeda.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_REFRESH_SECRET=ganti-dengan-string-acak-lain
# Origin yang boleh mengakses API langsung (dipisah koma). Contoh:
# CORS_ORIGIN=https://warungflow-web.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Opsional: kalau diisi, endpoint cron wajib header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# apps/web/.env.local
API_URL=http://localhost:4000
